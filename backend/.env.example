# ============================================
# 兰园公共底座 — 环境变量配置
# ============================================
# 使用方式：
#   cp backend/.env.example backend/.env
#   编辑 .env 填入实际值（.env 已被 .gitignore 忽略，不会提交）
# ============================================

# --- 数据库 ---
# 开发环境默认 SQLite
DATABASE_URL=sqlite+aiosqlite:///./lanyuan.db
# 生产环境 MySQL 示例（密码中的 @ 需编码为 %40）:
# DATABASE_URL=mysql+aiomysql://user:***@host:3306/lanyuan?charset=utf8mb4

# --- JWT 密钥 ---
# 生产环境请更换为随机生成的强密钥
JWT_SECRET_KEY=lanyuan-dev-secret-key-change-in-production

# --- LLM API（AI 对话需要，#15 Adapter） ---
# provider 与 protocol 两个正交维度（review #53 第二轮）：
#   LLM_PROVIDER=deepseek           # 厂商（未来: qwen/moonshot/zhipu/anthropic）
#   LLM_PROTOCOL=openai             # 协议: openai | anthropic | responses（对应该协议的 adapter）
LLM_PROVIDER=deepseek
LLM_PROTOCOL=openai
# base_url / model 留空 → 使用 (provider, protocol) 默认值（见 app/harness/adapters/providers.py）
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=your_llm_api_key_here

# --- 微信小程序 ---
# 本地：设为 False，并配置 AppID + Secret 调用 code2session
# 云托管：默认即为 True，无需配置本变量；只需配置 AppID（用于校验图片审核回调）
WECHAT_CLOUD_DEPLOYMENT=False
# 可选：本地模拟用户。非空时跳过 code2session；修改后重启后端并重新登录即可切换用户。
# 仅在 WECHAT_CLOUD_DEPLOYMENT=False 时生效，云托管会忽略。
WECHAT_MOCK_OPENID=
# 云托管服务开启公网访问时置 True：消息推送接口要求携带 x-wx-source 头，否则 403
# 建议保持关闭公网访问（False）
WECHAT_CLOUDRUN_PUBLIC_ACCESS=False
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret

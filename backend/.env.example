# ============================================
# 兰园公共底座 — 环境变量配置
# ============================================
# 使用方式：
#   cp backend/.env.example backend/.env
#   编辑 .env 填入实际值（.env 已被 .gitignore 忽略，不会提交）
# ============================================

# --- 应用 ---
DEBUG=True

# --- 数据库 ---
# 开发环境默认 SQLite
DATABASE_URL=sqlite+aiosqlite:///./lanyuan.db
# 生产环境 MySQL 示例:
# DATABASE_URL=mysql+asyncmy://user:password@host:3306/lanyuan

# --- JWT 密钥 ---
# 生产环境请更换为随机生成的强密钥
JWT_SECRET_KEY=lanyuan-dev-secret-key-change-in-production

# --- DeepSeek API（AI 对话需要） ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- 微信小程序 ---
WECHAT_APPID=wx_dev_appid
WECHAT_SECRET=wx_dev_secret

# --- 上传目录 ---
UPLOAD_DIR=./uploads

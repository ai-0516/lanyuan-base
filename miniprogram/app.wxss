/*
 * 兰园公共底座 — 全局样式
 */

/* 导入设计系统变量 */
@import './styles/variables.wxss';

/* ===== 全局重置 ===== */
page {
  background-color: var(--cream);
  color: var(--bark);
  font-size: var(--font-size-base);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Microsoft YaHei', sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

view,
scroll-view,
swiper,
movable-view,
cover-view {
  box-sizing: border-box;
}

/* ===== 通用容器 ===== */
.page-container {
  min-height: 100vh;
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
}

/* 白色卡片 */
.card {
  background-color: var(--warm-white);
  border-radius: var(--radius-base);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-base);
  margin-bottom: var(--spacing-base);
}

/* ===== 按钮 ===== */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background-color: var(--terracotta);
  color: #fff;
  font-size: var(--font-size-lg);
  border-radius: var(--radius-base);
  border: none;
  transition: opacity 0.2s;
}

.btn-primary:active {
  background-color: var(--terracotta-deep);
}

.btn-primary--disabled {
  background-color: var(--sand-dark);
  color: var(--clay);
  pointer-events: none;
}

.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background-color: transparent;
  color: var(--terracotta);
  font-size: var(--font-size-base);
  border-radius: var(--radius-base);
  border: 2rpx solid var(--terracotta);
}

.btn-secondary:active {
  background-color: var(--sand);
}

/* ===== 表单 ===== */
.input-field {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--spacing-base);
  background-color: var(--warm-white);
  border: 2rpx solid var(--sand);
  border-radius: var(--radius-base);
  font-size: var(--font-size-base);
  color: var(--bark);
}

.input-field::placeholder {
  color: var(--clay);
}

.input-field:focus {
  border-color: var(--terracotta);
}

/* ===== 文字 ===== */
.text-primary {
  color: var(--terracotta);
}

.text-secondary {
  color: var(--clay);
}

.text-bark {
  color: var(--bark);
}

.text-olive {
  color: var(--olive);
}

.text-gold {
  color: var(--gold);
}

.text-sm {
  font-size: var(--font-size-sm);
}

.text-lg {
  font-size: var(--font-size-lg);
}

.text-bold {
  font-weight: 600;
}

.text-center {
  text-align: center;
}

/* ===== 布局 ===== */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.align-center {
  align-items: center;
}

/* ===== 间距 ===== */
.mt-sm { margin-top: var(--spacing-sm); }
.mt-base { margin-top: var(--spacing-base); }
.mt-lg { margin-top: var(--spacing-lg); }
.mt-xl { margin-top: var(--spacing-xl); }

.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-base { margin-bottom: var(--spacing-base); }
.mb-lg { margin-bottom: var(--spacing-lg); }

.ml-sm { margin-left: var(--spacing-sm); }
.mr-sm { margin-right: var(--spacing-sm); }

.p-sm { padding: var(--spacing-sm); }
.p-base { padding: var(--spacing-base); }
.p-lg { padding: var(--spacing-lg); }

/* ===== 分割线 ===== */
.divider {
  height: 2rpx;
  background-color: var(--sand);
  margin: var(--spacing-base) 0;
}

/* ===== Loading ===== */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(250, 247, 242, 0.8);
  z-index: 999;
}

/* ===== 安全区域适配 ===== */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl) 0;
}

.empty-state__text {
  font-size: var(--font-size-sm);
  color: var(--clay);
  margin-top: var(--spacing-base);
}

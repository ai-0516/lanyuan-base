/* 通知页 — 对齐 v3-notifications.html 设计稿 */
.notif-page {
  min-height: 100vh;
  background: var(--cream);
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 100rpx 32rpx 20rpx;
  position: relative;
}
.back {
  position: absolute;
  left: 32rpx;
  font-size: 28rpx;
  color: var(--terracotta);
  font-weight: 500;
}
.title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--bark);
}
.nav-spacer {
  width: 80rpx;
}

.page-content {
  padding: 0 0 8rpx;
}

/* 通知列表 */
.notif-list {
  background: var(--warm-white);
  border-radius: 32rpx;
  margin: 12rpx 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(232, 213, 192, 0.4);
  overflow: hidden;
}
.notif-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 24rpx;
  border-bottom: 1rpx solid rgba(232, 213, 192, 0.25);
  transition: background 0.15s;
}
.notif-item:last-child {
  border-bottom: none;
}
.notif-item:active {
  background: rgba(196, 103, 60, 0.04);
}
.notif-item.unread {
  background: rgba(196, 103, 60, 0.03);
}

.notif-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  overflow: hidden;
  position: relative;
}
.notif-avatar image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.action-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  border: 4rpx solid var(--warm-white);
}
.action-badge.like {
  background: linear-gradient(135deg, #fce4d6, #f5cba0);
  color: #c4673c;
}
.action-badge.comment {
  background: linear-gradient(135deg, #d6eaf8, #aed6f1);
  color: #5b7fa5;
}

.notif-body {
  flex: 1;
  min-width: 0;
}
.notif-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--terracotta);
}
.notif-action {
  font-size: 26rpx;
  color: var(--bark);
}
.notif-post {
  font-size: 24rpx;
  color: #b8a898;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notif-time {
  font-size: 22rpx;
  color: #c8b8a8;
  flex-shrink: 0;
}
.notif-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--terracotta);
  flex-shrink: 0;
  margin-left: 8rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #c8b8a8;
  margin-top: 24rpx;
}

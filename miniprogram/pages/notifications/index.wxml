<view class="notif-page">
  <view class="nav-bar">
    <text class="back" bindtap="goBack">‹ 返回</text>
    <text class="title">消息通知</text>
    <view class="nav-spacer"></view>
  </view>

  <view class="page-content">
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{notifications.length === 0}}">
      <text style="font-size: 96rpx; opacity: 0.3;">🔔</text>
      <text class="empty-text">暂无消息通知</text>
    </view>

    <!-- 通知列表 -->
    <view class="notif-list" wx:if="{{notifications.length > 0}}">
      <view class="notif-item {{item.read ? '' : 'unread'}}" wx:for="{{notifications}}" wx:key="id" bindtap="onTapNotification" data-id="{{item.id}}" data-post-id="{{item.postId || item.post_id}}">
        <view class="notif-avatar">
          <image src="{{item.senderAvatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
          <text class="action-badge {{item.type === 'like' ? 'like' : 'comment'}}">{{item.type === 'like' ? '❤' : '💬'}}</text>
        </view>
        <view class="notif-body">
          <view>
            <text class="notif-name">{{item.senderName}}</text>
            <text class="notif-action">{{item.type === 'like' ? '点赞' : item.type === 'comment' ? '评论' : '回复'}}</text>
          </view>
          <view class="notif-post">{{item.postExcerpt}}</view>
        </view>
        <text class="notif-time">{{item.time}}</text>
        <view class="notif-dot" wx:if="{{!item.read}}"></view>
      </view>
    </view>
  </view>
</view>

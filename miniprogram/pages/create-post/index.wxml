<view class="create-post-page">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <view class="nav-left" bindtap="onCancel">
      <text class="cancel-text">取消</text>
    </view>
    <view class="nav-center">
      <text class="nav-title">发布</text>
    </view>
    <view class="nav-right">
      <button class="publish-btn {{canPublish ? '' : 'disabled'}}" disabled="{{!canPublish}}" bindtap="onPublish" loading="{{publishing}}">
        发布
      </button>
    </view>
  </view>

  <!-- 正文输入框 -->
  <view class="content-section">
    <textarea
      class="content-input"
      placeholder="分享你的想法..."
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="2000"
      auto-height
      show-count="{{false}}"
    ></textarea>
    <!-- 字数统计 -->
    <view class="word-count">
      <text class="count-text {{content.length > 2000 ? 'over' : ''}}">{{content.length}}</text>
      <text class="count-sep">/</text>
      <text class="count-max">2000</text>
    </view>
  </view>

  <!-- 图片选择 -->
  <view class="images-section">
    <view class="section-title">图片（{{images.length}}/9）</view>
    <view class="image-grid">
      <!-- 已有图片预览 -->
      <view wx:for="{{images}}" wx:key="index" class="image-item">
        <image class="preview-image" src="{{item}}" mode="aspectFill"></image>
        <view class="image-remove" bindtap="removeImage" data-index="{{index}}">
          <text class="remove-icon">×</text>
        </view>
      </view>
      <!-- 添加图片按钮 -->
      <view class="image-add-btn" wx:if="{{images.length < 9}}" bindtap="chooseImage">
        <text class="add-icon">+</text>
        <text class="add-text">添加</text>
      </view>
    </view>
  </view>
</view>

<view class="create-page">
  <!-- 导航栏 -->
  <view class="nav-bar">
    <view class="nav-placeholder"></view>
  </view>

  <!-- 内容区 -->
  <view class="page-content">
    <textarea class="textarea" placeholder="分享小区新鲜事…" value="{{content}}" bindinput="onContentInput" maxlength="500" auto-height></textarea>
    <text class="char-count {{content.length > 400 ? (content.length >= 500 ? 'over' : 'warn') : ''}}">{{content.length}}/500</text>

    <!-- 图片网格 -->
    <view class="image-grid">
      <view class="img-box add" wx:if="{{tempImages.length < 9}}" bindtap="chooseImage">
        <text>📷</text>
      </view>
      <view class="img-box filled" wx:for="{{tempImages}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill"></image>
        <view class="remove" data-index="{{index}}" bindtap="removeImage">✕</view>
      </view>
    </view>
  </view>

  <!-- 发布按钮 -->
  <button class="publish" bindtap="onPublish" disabled="{{!canPublish || publishing}}" loading="{{publishing}}">发布</button>
</view>

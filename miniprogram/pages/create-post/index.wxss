/* 发布帖子页样式 */
@import '../../styles/variables.wxss';

.create-post-page {
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 32rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0e8e0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-left {
  min-width: 120rpx;
}

.cancel-text {
  font-size: 30rpx;
  color: #8a7a6c;
}

.nav-center {
  flex: 1;
  text-align: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.nav-right {
  min-width: 120rpx;
  display: flex;
  justify-content: flex-end;
}

.publish-btn {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  background: #c4673c;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #fff;
  border: none;
  font-weight: 500;
}

.publish-btn::after {
  border: none;
}

.publish-btn:active:not(.disabled) {
  opacity: 0.85;
}

.publish-btn.disabled {
  background: #d4bfb2;
  color: #f5ede8;
}

/* 正文输入区域 */
.content-section {
  padding: 32rpx 32rpx 16rpx;
  position: relative;
}

.content-input {
  width: 100%;
  min-height: 280rpx;
  font-size: 30rpx;
  color: #3d2b1f;
  line-height: 1.6;
  padding: 0;
  box-sizing: border-box;
}

.content-input::placeholder {
  color: #c4b8ad;
}

/* 字数统计 */
.word-count {
  text-align: right;
  padding: 12rpx 0 0;
}

.count-text {
  font-size: 26rpx;
  color: #8a7a6c;
}

.count-text.over {
  color: #e74c3c;
}

.count-sep {
  font-size: 26rpx;
  color: #c4b8ad;
}

.count-max {
  font-size: 26rpx;
  color: #c4b8ad;
}

/* 图片选择区域 */
.images-section {
  padding: 16rpx 32rpx 40rpx;
}

.section-title {
  font-size: 28rpx;
  color: #8a7a6c;
  margin-bottom: 24rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 210rpx;
  height: 210rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-icon {
  font-size: 32rpx;
  color: #fff;
  line-height: 1;
}

.image-add-btn {
  width: 210rpx;
  height: 210rpx;
  border: 2rpx dashed #d4bfb2;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8f4ef;
}

.image-add-btn:active {
  background: #f0e8e0;
}

.add-icon {
  font-size: 56rpx;
  color: #c4b8ad;
  line-height: 1;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: #c4b8ad;
}

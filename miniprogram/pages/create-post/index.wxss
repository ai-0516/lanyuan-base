/* 发布帖子 — 对齐 v3-create-post.html 设计稿 */
.create-page {
  min-height: 100vh;
  background: var(--cream);
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 32rpx 20rpx;
}
.cancel, .nav-placeholder {
  font-size: 28rpx;
  color: #b8a898;
  flex-shrink: 0;
  width: 80rpx;
}
.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--bark);
}
.publish {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, var(--ember), var(--clay));
  border: none;
  padding: 12rpx 36rpx;
  border-radius: 32rpx;
  transition: all 0.2s;
}
.publish::after {
  border: none;
}
.publish[disabled] {
  background: #d8c8b8;
}

/* 内容区 */
.page-content {
  background: var(--warm-white);
  padding: 32rpx;
  margin: 8rpx 24rpx 24rpx;
  border-radius: 32rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(232, 213, 192, 0.4);
  min-height: 400rpx;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  border: none;
  background: transparent;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--bark);
}
.textarea::placeholder {
  color: #d8c8b8;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #d8c8b8;
  margin-top: 16rpx;
}
.char-count.warn {
  color: var(--gold);
}
.char-count.over {
  color: var(--terracotta);
}

/* 图片网格 */
.image-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 24rpx;
}
.img-box {
  width: 156rpx;
  height: 156rpx;
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
}
.img-box.add {
  border: 3rpx dashed rgba(196, 103, 60, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  background: var(--cream);
}
.img-box image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.remove {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--terracotta);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

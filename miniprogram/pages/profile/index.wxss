@import '../../styles/variables.wxss';

/* 页面容器 */
.profile-page {
  min-height: 100vh;
  background-color: var(--bg-page, #f5f0eb);
  padding-bottom: 40rpx;
}

/* 顶部用户信息区 */
.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx 40rpx;
  background: linear-gradient(135deg, var(--clay, #c4a882), var(--ember, #b87333));
}
.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
}
.user-nickname {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}
.user-community {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 菜单卡片 */
.menu-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx;
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.menu-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.menu-icon {
  font-size: 36rpx;
}
.menu-label {
  font-size: 28rpx;
  color: #3a2c1e;
}
.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.menu-arrow {
  font-size: 36rpx;
  color: #bbb;
}

/* 未读角标 */
.badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background-color: #ee3f3f;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.badge-text {
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 600;
}

/* 设置分区标题 */
.settings-section {
  margin-top: 20rpx;
}
.section-title {
  padding: 24rpx 32rpx 8rpx;
  font-size: 26rpx;
  color: #999;
}

/* 隐私设置卡片 */
.privacy-card {
  flex-direction: column;
  align-items: stretch;
}
.privacy-items {
  margin-top: 16rpx;
  border-top: 1rpx solid #f0ebe6;
  padding-top: 16rpx;
}
.privacy-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}
.privacy-label {
  font-size: 26rpx;
  color: #666;
}
.privacy-switch {
  transform: scale(0.8);
  transform-origin: right center;
}

/* 退出登录卡片 */
.logout-card {
  justify-content: center;
  margin-top: 20rpx;
}
.logout-text {
  font-size: 28rpx;
  color: #ee3f3f;
  font-weight: 500;
}

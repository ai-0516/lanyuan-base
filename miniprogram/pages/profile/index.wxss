/* 个人中心 — 对齐 v3-profile.html 设计稿 */
.profile-page {
  min-height: 100vh;
  background: var(--cream);
  padding: 40rpx 24rpx 40rpx;
}

/* ── 用户信息卡 ── */
.profile-card {
  background: var(--warm-white);
  border-radius: 32rpx;
  padding: 40rpx 32rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(232, 213, 192, 0.4);
}
.avatar-wrap {
  width: 144rpx;
  height: 144rpx;
  margin: 0 auto 24rpx;
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}
.avatar {
  width: 100%;
  height: 100%;
  display: block;
}
.avatar-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--terracotta-light), var(--terracotta-deep));
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-svg {
  width: 64rpx;
  height: 64rpx;
  color: #fff;
}
.avatar-default-icon {
  width: 72rpx;
  height: 72rpx;
}
.nickname {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--bark);
  margin-bottom: 4rpx;
}
.community-info {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}
.community-info span {
  background: var(--sand);
  color: var(--bark);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}
.edit-btn {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--terracotta);
  padding: 12rpx 36rpx;
  border: 1.5rpx solid rgba(196, 103, 60, 0.3);
  border-radius: 32rpx;
  transition: all 0.2s;
  font-weight: 500;
}
.edit-btn:active {
  background: rgba(196, 103, 60, 0.04);
  border-color: var(--terracotta);
}
.edit-icon {
  width: 26rpx;
  height: 26rpx;
}

/* ── 消息通知卡片 ── */
.notify-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--warm-white);
  border-radius: 32rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(232, 213, 192, 0.4);
}
.notify-card:active {
  box-shadow: var(--shadow-md);
}
.notify-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.notify-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--gold-light), var(--gold));
  display: flex;
  align-items: center;
  justify-content: center;
}
.notify-icon-wrap svg {
  width: 36rpx;
  height: 36rpx;
  color: #fff;
}
.notify-icon {
  width: 36rpx;
  height: 36rpx;
}
.notify-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--bark);
}
.notify-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}
.badge {
  background: var(--terracotta);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  min-width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
}
.arrow-svg {
  width: 28rpx;
  height: 28rpx;
  color: #d8c8b8;
  flex-shrink: 0;
}

/* ── 分区标签 ── */
.section-label {
  font-size: 22rpx;
  color: #b8a898;
  padding: 16rpx 8rpx 12rpx;
  letter-spacing: 1rpx;
  font-weight: 500;
}

/* ── 设置卡片 ── */
.setting-section {
  background: var(--warm-white);
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(232, 213, 192, 0.4);
}
.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(232, 213, 192, 0.3);
  transition: background 0.15s;
}
.setting-item:last-child {
  border-bottom: none;
}
.setting-item:active {
  background: rgba(196, 103, 60, 0.04);
}
.set-label {
  font-size: 28rpx;
  color: var(--bark);
}
.set-arrow {
  width: 28rpx;
  height: 28rpx;
  color: #d8c8b8;
  flex-shrink: 0;
}
.set-value {
  font-size: 24rpx;
  color: #b8a898;
}

/* ── Toggle 开关 ── */
.toggle {
  width: 100rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: #d8c8b8;
  position: relative;
  transition: background 0.3s;
  flex-shrink: 0;
}
.toggle.on {
  background: var(--terracotta);
}
.knob {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #fff;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: left 0.3s;
  box-shadow: 0 2rpx 6rpx rgba(61, 43, 31, 0.15);
}
.toggle.on .knob {
  left: 44rpx;
}

/* ── 退出登录按钮 ── */
.logout-btn {
  width: 100%;
  padding: 24rpx;
  background: var(--warm-white);
  color: var(--terracotta);
  border: 1.5rpx solid rgba(196, 103, 60, 0.3);
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s;
  text-align: center;
  margin-top: 8rpx;
  box-sizing: border-box;
}
.logout-btn:active {
  transform: scale(0.98);
}

/* ── 退出确认弹窗 ── */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(61, 43, 31, 0.4);
  display: none;
  align-items: flex-end;
  justify-content: center;
  z-index: 500;
}
.modal-overlay.show {
  display: flex;
}
.modal-sheet {
  width: 100%;
  background: var(--warm-white);
  border-radius: 40rpx 40rpx 0 0;
  padding: 32rpx 0 40rpx;
  animation: slideUp 0.35s ease;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.modal-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--bark);
  padding: 16rpx 0 32rpx;
  border-bottom: 1rpx solid rgba(232, 213, 192, 0.4);
  margin-bottom: 16rpx;
}
.modal-action {
  text-align: center;
  padding: 28rpx;
  font-size: 30rpx;
  transition: background 0.15s;
  color: var(--bark);
}
.modal-action.danger {
  color: var(--terracotta);
  font-weight: 500;
}
.modal-action.cancel {
  color: #b8a898;
  margin-top: 8rpx;
}

/* ── 渐入动画（stagger） ── */
.anim-1 {
  animation: fadeIn 0.4s ease both;
}
.anim-2 {
  animation: fadeIn 0.4s 0.06s ease both;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

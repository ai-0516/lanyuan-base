<view class="chat-page">
  <!-- 消息列表 -->
  <scroll-view class="message-list" scroll-y scroll-into-view="{{lastMsgId}}" scroll-with-animation scroll-anchoring>
    <view class="chat">
      <view class="msg ai" wx:for="{{messages}}" wx:key="index" wx:if="{{item.role === 'assistant'}}">
        <view class="msg-avatar ai">AI</view>
        <view class="msg-bubble ai">
          <text class="bubble-text">{{item.content}}</text>
        </view>
        <text class="msg-time">{{item.time}}</text>
      </view>
      <view class="msg me" wx:for="{{messages}}" wx:key="index" wx:if="{{item.role === 'user'}}">
        <view class="msg-avatar me">我</view>
        <view class="msg-bubble me">
          <text class="bubble-text">{{item.content}}</text>
        </view>
        <text class="msg-time">{{item.time}}</text>
      </view>
    </view>
    <view id="msg-end" style="height:1rpx;"></view>
  </scroll-view>

  <!-- 底部输入区 -->
  <view class="chat-input-wrap">
    <textarea class="input-textarea" placeholder="输入消息…" value="{{inputValue}}" bindinput="onInputChange" disabled="{{isLoading}}" auto-height maxlength="-1"></textarea>
    <button class="send-btn" bindtap="onSend" disabled="{{!inputValue.trim() || isLoading}}">→</button>
  </view>
</view>

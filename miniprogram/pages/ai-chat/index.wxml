<view class="chat-page">
  <!-- 消息列表 -->
  <scroll-view class="message-list" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{lastMsgId}}" scroll-with-animation scroll-anchoring>
    <view class="chat">
      <view class="msg {{item.role === 'assistant' ? 'ai' : 'me'}}" wx:for="{{messages}}" wx:key="index">
        <view class="msg-avatar {{item.role === 'assistant' ? 'ai' : 'me'}}">{{item.role === 'assistant' ? 'AI' : '我'}}</view>
        <view class="msg-bubble {{item.role === 'assistant' ? 'ai' : 'me'}}">
          <block wx:if="{{item.role === 'assistant'}}">
            <block wx:if="{{item.content.length > 0}}">
              <towxml nodes="{{item.nodes}}"/>
            </block>
            <block wx:else>
              <text class="bubble-loading">。。。</text>
            </block>
          </block>
          <block wx:else>
            <text class="bubble-text" selectable="{{true}}">{{item.content}}</text>
          </block>
        </view>
        <text class="msg-time">{{item.time}}</text>
      </view>
    </view>
    <view id="msg-end" style="height:1rpx;"></view>
  </scroll-view>

  <!-- 底部输入区 -->
  <view class="chat-input-wrap">
    <textarea class="input-textarea" placeholder="输入消息…" value="{{inputValue}}" bindinput="onInputChange" disabled="{{isLoading}}" auto-height maxlength="-1"></textarea>
    <view class="send-btn {{canSend && !isLoading ? 'active' : ''}}" bindtap="onSend">→</view>
  </view>
</view>

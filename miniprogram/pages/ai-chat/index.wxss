/* AI 对话页 — 对齐 v3-ai-chat.html 设计稿 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--cream);
}

/* 消息列表 — 对齐设计: padding 0 16px 8px */
.message-list {
  flex: 1;
  padding: 0 32rpx 16rpx;
  overflow-y: scroll;
}

/* 对话 */
.chat {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 消息行 — 对齐设计: fadeIn 动画 */
.msg {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  animation: fadeIn 0.3s ease;
}
.msg.me {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.msg-avatar.ai {
  background: linear-gradient(135deg, var(--terracotta-light), var(--terracotta));
}
.msg-avatar.me {
  background: linear-gradient(135deg, var(--clay), var(--terracotta-deep));
}

/* 气泡 */
.msg-bubble {
  padding: 20rpx 28rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  line-height: 1.6;
  max-width: 78%;
  word-break: break-word;
}
.msg-bubble.ai {
  background: var(--warm-white);
  color: var(--bark);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(232, 213, 192, 0.3);
  border-bottom-left-radius: 8rpx;
}
.msg-bubble.me {
  background: linear-gradient(135deg, var(--ember), var(--clay));
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

.msg-time {
  font-size: 20rpx;
  color: #c8b8a8;
  align-self: flex-end;
  flex-shrink: 0;
}

/* 底部输入区 — 对齐设计: margin 8px 16px 0 / border-radius 18px */
.chat-input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--warm-white);
  border-radius: 36rpx;
  padding: 12rpx 12rpx 12rpx 32rpx;
  margin: 16rpx 32rpx 40rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(232, 213, 192, 0.4);
  flex-shrink: 0;
}
.input-textarea {
  border: none;
  background: transparent;
  flex: 1;
  font-size: 26rpx;
  color: var(--bark);
  line-height: 1.4;
  padding: 8rpx 0;
  max-height: 120rpx;
}
.send-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #d8c8b8;
  border: none;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-weight: 600;
  padding: 0;
  line-height: 1;
  transition: transform 0.2s, background 0.2s;
}
.send-btn:active {
  transform: scale(0.92);
}
.send-btn.active {
  background: linear-gradient(135deg, var(--terracotta), var(--clay));
}

/* ── 动画: 对齐设计 fadeIn 0.3s ease ── */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

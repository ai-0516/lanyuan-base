/* 帖子详情页样式 */
.detail-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--cream);
}

/* 滚动区 */
.detail-scroll {
  flex: 1;
  overflow-y: scroll;
}
.detail-scroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

/* 加载中 */
.loading-placeholder {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}
.loading-text {
  font-size: 28rpx;
  color: #b8a898;
}

/* 帖子卡片 */
.post-card {
  background: var(--warm-white);
  margin: 12rpx 24rpx;
  border-radius: 32rpx;
  padding: 32rpx 28rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(232, 213, 192, 0.4);
}

/* 帖子头部 */
.post-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: block;
  background: var(--sand);
  flex-shrink: 0;
}
.post-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.post-author {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--bark);
}
.post-time {
  font-size: 22rpx;
  color: #b8a898;
}

/* 帖子正文 */
.post-body {
  font-size: 28rpx;
  line-height: 1.7;
  color: #5c4a3a;
  margin-bottom: 20rpx;
  word-break: break-word;
}

/* 图片网格 */
.post-images {
  display: grid;
  gap: 8rpx;
  margin-bottom: 20rpx;
}
.post-images.count-1 {
  grid-template-columns: 1fr;
}
.post-images.count-1 image {
  max-height: 400rpx;
  object-fit: cover;
  border-radius: 16rpx;
  width: 100%;
}
.post-images.count-2 {
  grid-template-columns: 1fr 1fr;
}
.post-images.count-2 image {
  aspect-ratio: 1;
  border-radius: 16rpx;
}
.post-images.count-3,
.post-images.count-4 {
  grid-template-columns: 1fr 1fr;
}
.post-images.count-3 image:first-child {
  grid-column: 1 / -1;
  max-height: 300rpx;
  object-fit: cover;
  border-radius: 16rpx;
}
.post-images.count-4 image {
  aspect-ratio: 1;
  border-radius: 16rpx;
}
.post-images.count-5,
.post-images.count-6 {
  grid-template-columns: 1fr 1fr 1fr;
}
.post-images.count-5 image,
.post-images.count-6 image {
  aspect-ratio: 1;
  border-radius: 12rpx;
}
.post-images.count-7,
.post-images.count-8,
.post-images.count-9 {
  grid-template-columns: 1fr 1fr 1fr;
}
.post-images.count-7 image,
.post-images.count-8 image,
.post-images.count-9 image {
  aspect-ratio: 1;
  border-radius: 12rpx;
}

/* 点赞统计 */
.post-stats {
  font-size: 24rpx;
  color: #b8a898;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(232, 213, 192, 0.3);
}

/* 分隔 */
.section-divider {
  height: 16rpx;
  margin: 0 24rpx;
}

/* 评论头部 */
.comments-header {
  padding: 24rpx 28rpx 8rpx;
  background: var(--warm-white);
  margin: 0 24rpx;
  border-radius: 32rpx 32rpx 0 0;
}
.comments-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--bark);
}

/* 空评论 */
.empty-comments {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx 0;
  background: var(--warm-white);
  margin: 0 24rpx;
  border-radius: 0 0 32rpx 32rpx;
}
.empty-comments-text {
  font-size: 26rpx;
  color: #b8a898;
}

/* 评论列表 */
.comments-list {
  background: var(--warm-white);
  margin: 0 24rpx;
  border-radius: 0 0 32rpx 32rpx;
  padding: 0 28rpx 16rpx;
}
.comment-item {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(232, 213, 192, 0.2);
}
.comment-item:active {
  background: rgba(196, 103, 60, 0.03);
  margin: 0 -28rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
}
.comment-item:last-child {
  border-bottom: none;
}
.comment-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background: var(--sand);
}
.comment-body {
  flex: 1;
  min-width: 0;
}
.comment-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}
.comment-author {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--terracotta);
}
.comment-time {
  font-size: 20rpx;
  color: #c8b8a8;
}
.comment-content {
  font-size: 26rpx;
  color: #5c4a3a;
  line-height: 1.5;
}
.comment-text {
  word-break: break-word;
}
.reply-label {
  color: #b8a898;
}
.reply-author {
  font-weight: 600;
  color: var(--terracotta);
}
.reply-colon {
  color: #b8a898;
}

/* 底部占位 */
.bottom-spacer {
  height: 160rpx;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--warm-white);
  border-top: 1rpx solid rgba(232, 213, 192, 0.4);
  padding: 12rpx 24rpx calc(env(safe-area-inset-bottom) + 12rpx);
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  box-shadow: 0 -2rpx 12rpx rgba(61, 43, 31, 0.04);
}
.bar-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding-bottom: 8rpx;
}
.bar-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 32rpx;
  padding: 8rpx 12rpx;
  border-radius: 16rpx;
}
.bar-btn:active {
  background: rgba(196, 103, 60, 0.08);
}
.bar-count {
  font-size: 22rpx;
  color: var(--clay);
}
.bar-btn.liked .bar-count {
  color: var(--terracotta);
}
.bar-input-area {
  flex: 1;
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  flex-wrap: wrap;
}
.reply-hint {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--terracotta);
  padding: 0 16rpx;
  margin-bottom: 4rpx;
}
.cancel-reply {
  font-size: 24rpx;
  padding: 4rpx 8rpx;
  color: var(--clay);
}
.bar-input {
  flex: 1;
  min-height: 64rpx;
  max-height: 160rpx;
  background: var(--cream);
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  color: var(--bark);
  line-height: 1.4;
}
.bar-input::placeholder {
  color: #b8a898;
}
.bar-send {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--sand-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  flex-shrink: 0;
  transition: background 0.15s;
}
.bar-send.active {
  background: var(--terracotta);
}
.bar-send:active {
  opacity: 0.8;
}

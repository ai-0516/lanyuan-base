/* 帖子详情页 — 帖子部分样式完全对齐 feed 页 */

/* 页面布局 */
.detail-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--cream);
}
.detail-scroll {
  flex: 1;
  overflow-y: scroll;
}
.detail-scroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}
page {
  overflow: hidden;
}
page::-webkit-scrollbar {
  display: none;
}

/* 加载中 */
.loading-placeholder {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}
.loading-text {
  font-size: 28rpx;
  color: #b8a898;
}

/* ===== 以下完全对齐 feed/index.wxss ===== */

/* 帖子容器 */
.feed-post {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 24rpx 8rpx;
  border-bottom: 1rpx solid rgba(232, 213, 192, 0.4);
}
.post-left {
  flex-shrink: 0;
}
.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: block;
  background: var(--sand);
}
.post-right {
  flex: 1;
  min-width: 0;
}

/* 帖子头部 */
.feed-header {
  margin-bottom: 8rpx;
}
.feed-user {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--bark);
}

/* 帖子正文 */
.feed-body {
  font-size: 26rpx;
  line-height: 1.6;
  color: #5c4a3a;
  margin-bottom: 16rpx;
  word-break: break-word;
}

/* 图片网格 */
.feed-images {
  display: grid;
  gap: 4rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
}
.feed-images image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.feed-images.count-1 {
  grid-template-columns: 1fr;
}
.feed-images.count-1 image {
  aspect-ratio: 16/9;
}
.feed-images.count-2 {
  grid-template-columns: 1fr 1fr;
}
.feed-images.count-2 image {
  aspect-ratio: 1/1;
}
.feed-images.count-3 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto auto;
}
.feed-images.count-3 image:first-child {
  grid-column: 1 / -1;
  aspect-ratio: 16/9;
}
.feed-images.count-3 image:nth-child(2),
.feed-images.count-3 image:nth-child(3) {
  aspect-ratio: 1/1;
}
.feed-images.count-4 {
  grid-template-columns: 1fr 1fr;
}
.feed-images.count-4 image {
  aspect-ratio: 1/1;
}
.feed-images.count-5,
.feed-images.count-6,
.feed-images.count-7,
.feed-images.count-8,
.feed-images.count-9 {
  grid-template-columns: 1fr 1fr 1fr;
}
.feed-images.count-5 image,
.feed-images.count-6 image,
.feed-images.count-7 image,
.feed-images.count-8 image,
.feed-images.count-9 image {
  aspect-ratio: 1/1;
}

/* 操作栏 */
.feed-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #b8a898;
  padding-top: 4rpx;
  position: relative;
  min-height: 48rpx;
}
.action-left {
  font-size: 22rpx;
  color: #b8a898;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 点赞名单 */
.likers-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  padding: 8rpx 0;
}
.like-icon-small {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.likers-text {
  font-size: 22rpx;
  color: var(--terracotta);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 评论预览 */
.comment-preview {
  background: #f8f2e9;
  border-radius: 24rpx;
  padding: 16rpx;
  margin-top: 12rpx;
}
.comment-inline {
  display: flex;
  gap: 8rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
.ci-body {
  flex: 1;
  min-width: 0;
}
.ci-author {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--terracotta);
  display: inline;
}
.ci-reply {
  font-size: 24rpx;
  color: #b8a898;
  display: inline;
  padding: 0 6rpx;
}
.ci-text {
  font-size: 24rpx;
  color: #7a6a5a;
  display: inline;
}

/* ===== 详情页特有: 全部评论列表 ===== */
.full-comments {
  background: var(--warm-white);
  margin: 0 24rpx;
  border-radius: 32rpx;
  padding: 24rpx 28rpx;
  margin-top: 16rpx;
}
.fc-header {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--bark);
  margin-bottom: 16rpx;
}
.comment-inline.full {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  align-items: flex-start;
}
.comment-inline.full:last-child {
  margin-bottom: 0;
}
.fc-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--sand);
}
.fc-body {
  flex: 1;
  min-width: 0;
}
.fc-time {
  font-size: 20rpx;
  color: #c8b8a8;
  display: block;
  margin-top: 4rpx;
}

/* 底部占位 */
.bottom-spacer {
  height: 160rpx;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--warm-white);
  border-top: 1rpx solid rgba(232, 213, 192, 0.4);
  padding: 12rpx 24rpx calc(env(safe-area-inset-bottom) + 12rpx);
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  box-shadow: 0 -2rpx 12rpx rgba(61, 43, 31, 0.04);
}

/* 底部点赞按钮 */
.bar-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #b8a898;
  padding: 8rpx 12rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.bar-btn:active {
  color: var(--terracotta);
}
.bar-btn.liked {
  color: var(--terracotta);
}
.bar-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 底部输入区 */
.bar-input-area {
  flex: 1;
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  flex-wrap: wrap;
}
.reply-hint {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--terracotta);
  padding: 0 16rpx;
  margin-bottom: 4rpx;
}
.cancel-reply {
  font-size: 24rpx;
  padding: 4rpx 8rpx;
  color: var(--clay);
}
.bar-input {
  flex: 1;
  min-height: 64rpx;
  max-height: 160rpx;
  background: var(--cream);
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  color: var(--bark);
  line-height: 1.4;
}
.bar-input::placeholder {
  color: #b8a898;
}
.bar-send {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--sand-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  flex-shrink: 0;
  transition: background 0.15s;
}
.bar-send.active {
  background: var(--terracotta);
}
.bar-send:active {
  opacity: 0.8;
}

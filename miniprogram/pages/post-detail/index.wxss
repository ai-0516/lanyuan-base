/* 帖子详情页 — 页面布局 + 评论弹窗，帖子样式在 post-card 组件中 */

.detail-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--cream);
}
.detail-scroll {
  flex: 1;
  overflow-y: scroll;
}
.detail-scroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}
page {
  overflow: hidden;
}
page::-webkit-scrollbar {
  display: none;
}

/* 加载中 */
.loading-placeholder {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}
.loading-text {
  font-size: 28rpx;
  color: #b8a898;
}

/* ===== 评论弹窗 ===== */
.comment-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(61, 43, 31, 0.3);
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}
.comment-overlay.show {
  opacity: 1;
  pointer-events: auto;
}
.comment-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--warm-white);
  border-radius: 32rpx 32rpx 0 0;
  z-index: 201;
  padding: 32rpx 32rpx 48rpx;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -8rpx 48rpx rgba(61, 43, 31, 0.1);
}
.comment-sheet.show {
  transform: translateY(0);
}
.cs-input-area {
  display: flex;
  gap: 16rpx;
  align-items: center;
  background: var(--cream);
  border-radius: 32rpx;
  padding: 12rpx;
  min-height: 96rpx;
}
.cs-input {
  flex: 1;
  background: transparent;
  border-radius: 0;
  padding: 8rpx 16rpx;
  font-size: 28rpx;
  color: var(--bark);
  line-height: 1.5;
  border: none;
  max-height: 200rpx;
}
.cs-send {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #d8c8b8;
  color: #fff;
  border: none;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 72rpx;
  text-align: center;
  padding: 0;
  transition: transform 0.2s, background 0.2s;
}
.cs-send:active {
  transform: scale(0.92);
}
.cs-send.active {
  background: linear-gradient(135deg, var(--ember), var(--clay));
  color: #fff;
}

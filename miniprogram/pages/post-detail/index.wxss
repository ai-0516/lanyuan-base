/* 帖子详情页 — 样式完全对齐 feed 页 */

/* 页面布局 */
.detail-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--cream);
}
.detail-scroll {
  flex: 1;
  overflow-y: scroll;
}
.detail-scroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}
page {
  overflow: hidden;
}
page::-webkit-scrollbar {
  display: none;
}

/* 加载中 */
.loading-placeholder {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}
.loading-text {
  font-size: 28rpx;
  color: #b8a898;
}

/* ===== 以下完全对齐 feed/index.wxss ===== */

/* 帖子容器 */
.feed-post {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 24rpx 8rpx;
  border-bottom: 1rpx solid rgba(232, 213, 192, 0.4);
}
.post-left {
  flex-shrink: 0;
}
.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: block;
  background: var(--sand);
}
.post-right {
  flex: 1;
  min-width: 0;
}

/* 帖子头部 */
.feed-header {
  margin-bottom: 8rpx;
}
.feed-user {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--bark);
}

/* 帖子正文 */
.feed-body {
  font-size: 26rpx;
  line-height: 1.6;
  color: #5c4a3a;
  margin-bottom: 16rpx;
  word-break: break-word;
}

/* 图片网格 */
.feed-images {
  display: grid;
  gap: 4rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
}
.feed-images image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.feed-images.count-1 {
  grid-template-columns: 1fr;
}
.feed-images.count-1 image {
  aspect-ratio: 16/9;
}
.feed-images.count-2 {
  grid-template-columns: 1fr 1fr;
}
.feed-images.count-2 image {
  aspect-ratio: 1/1;
}
.feed-images.count-3 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto auto;
}
.feed-images.count-3 image:first-child {
  grid-column: 1 / -1;
  aspect-ratio: 16/9;
}
.feed-images.count-3 image:nth-child(2),
.feed-images.count-3 image:nth-child(3) {
  aspect-ratio: 1/1;
}
.feed-images.count-4 {
  grid-template-columns: 1fr 1fr;
}
.feed-images.count-4 image {
  aspect-ratio: 1/1;
}
.feed-images.count-5,
.feed-images.count-6,
.feed-images.count-7,
.feed-images.count-8,
.feed-images.count-9 {
  grid-template-columns: 1fr 1fr 1fr;
}
.feed-images.count-5 image,
.feed-images.count-6 image,
.feed-images.count-7 image,
.feed-images.count-8 image,
.feed-images.count-9 image {
  aspect-ratio: 1/1;
}

/* 操作栏 */
.feed-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #b8a898;
  padding-top: 4rpx;
  position: relative;
  min-height: 48rpx;
}
.action-left {
  font-size: 22rpx;
  color: #b8a898;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 滑出操作面板 */
.action-slide {
  display: flex;
  gap: 24rpx;
  align-items: center;
  position: absolute;
  right: 40rpx;
  top: 2rpx;
  transform: translateX(32rpx);
  transition: transform 0.25s ease, opacity 0.25s;
  z-index: 10;
  opacity: 0;
  visibility: hidden;
  background: var(--warm-white);
  border-radius: 20rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(61, 43, 31, 0.1);
  border: 1rpx solid rgba(232, 213, 192, 0.3);
}
.feed-actions.open .action-slide {
  transform: translateX(0);
  opacity: 1;
  visibility: visible;
}
.slide-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #b8a898;
  transition: color 0.2s;
  white-space: nowrap;
}
.slide-btn:active {
  color: var(--terracotta);
}
.slide-btn.liked {
  color: var(--terracotta);
}
.slide-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 三点菜单 */
.action-dots {
  font-size: 36rpx;
  color: #b8a898;
  line-height: 1;
  padding: 4rpx 8rpx;
  letter-spacing: 4rpx;
  z-index: 2;
  position: relative;
}
.action-dots:active {
  color: var(--terracotta);
}

/* 点赞名单 */
.likers-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  padding: 8rpx 0;
}
.like-icon-small {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.likers-text {
  font-size: 22rpx;
  color: var(--terracotta);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 评论预览 */
.comment-preview {
  background: #f8f2e9;
  border-radius: 24rpx;
  padding: 16rpx;
  margin-top: 12rpx;
}
.comment-inline {
  display: flex;
  gap: 8rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
.ci-body {
  flex: 1;
  min-width: 0;
}
.ci-author {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--terracotta);
  display: inline;
}
.ci-reply {
  font-size: 24rpx;
  color: #b8a898;
  display: inline;
  padding: 0 6rpx;
}
.ci-text {
  font-size: 24rpx;
  color: #7a6a5a;
  display: inline;
}

/* ===== 评论弹窗（完全对齐 feed） ===== */
.comment-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(61, 43, 31, 0.3);
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}
.comment-overlay.show {
  opacity: 1;
  pointer-events: auto;
}
.comment-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--warm-white);
  border-radius: 32rpx 32rpx 0 0;
  z-index: 201;
  padding: 32rpx 32rpx 48rpx;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -8rpx 48rpx rgba(61, 43, 31, 0.1);
}
.comment-sheet.show {
  transform: translateY(0);
}
.cs-input-area {
  display: flex;
  gap: 16rpx;
  align-items: center;
  background: var(--cream);
  border-radius: 32rpx;
  padding: 12rpx;
  min-height: 96rpx;
}
.cs-input {
  flex: 1;
  background: transparent;
  border-radius: 0;
  padding: 8rpx 16rpx;
  font-size: 28rpx;
  color: var(--bark);
  line-height: 1.5;
  border: none;
  max-height: 200rpx;
}
.cs-send {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #d8c8b8;
  color: #fff;
  border: none;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 72rpx;
  text-align: center;
  padding: 0;
  transition: transform 0.2s, background 0.2s;
}
.cs-send:active {
  transform: scale(0.92);
}
.cs-send.active {
  background: linear-gradient(135deg, var(--ember), var(--clay));
  color: #fff;
}

<view class="detail-page">
  <!-- 加载中 -->
  <view class="loading-placeholder" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 内容区 -->
  <scroll-view class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}" wx:if="{{!loading && post}}">
    <!-- 帖子卡片 -->
    <view class="post-card">
      <!-- 帖子头部 -->
      <view class="post-header">
        <image class="post-avatar" src="{{fullUrl(post.user.avatar)}}" mode="aspectFill"></image>
        <view class="post-meta">
          <text class="post-author">{{post.user.nickname}}</text>
          <text class="post-time">{{displayTime}}</text>
        </view>
      </view>

      <!-- 帖子正文 -->
      <view class="post-body">{{post.content}}</view>

      <!-- 图片网格 -->
      <view class="post-images count-{{post.images.length}}" wx:if="{{post.images && post.images.length > 0}}">
        <image wx:for="{{post.images}}" wx:for-item="img" wx:key="*this" src="{{fullUrl(img)}}" mode="aspectFill" bindtap="previewImage" data-current="{{img}}" data-urls="{{post.images}}"></image>
      </view>

      <!-- 点赞和评论数 -->
      <view class="post-stats">
        <text wx:if="{{post.likers && post.likers.length > 0}}">{{post.likers.length}} 人觉得很赞</text>
      </view>
    </view>

    <!-- 分隔 -->
    <view class="section-divider"></view>

    <!-- 评论列表标题 -->
    <view class="comments-header">
      <text class="comments-title">评论 ({{post.comments.length}})</text>
    </view>

    <!-- 空评论 -->
    <view class="empty-comments" wx:if="{{post.comments.length === 0}}">
      <text class="empty-comments-text">暂无评论</text>
    </view>

    <!-- 评论列表 -->
    <view class="comments-list" wx:if="{{post.comments.length > 0}}">
      <view class="comment-item" wx:for="{{post.comments}}" wx:for-item="cm" wx:key="id" bindtap="onTapComment" data-cid="{{cm.id}}" data-cuid="{{cm.user.id}}" data-cname="{{cm.user.nickname}}">
        <image class="comment-avatar" src="{{fullUrl(cm.user.avatar)}}" mode="aspectFill"></image>
        <view class="comment-body">
          <view class="comment-head">
            <text class="comment-author">{{cm.user.nickname}}</text>
            <text class="comment-time">{{formatTime(cm.created_at)}}</text>
          </view>
          <view class="comment-content">
            <text wx:if="{{cm.reply_to}}" class="reply-label">回复</text>
            <text wx:if="{{cm.reply_to}}" class="reply-author">{{cm.reply_to.nickname}}</text>
            <text wx:if="{{cm.reply_to}}" class="reply-colon">：</text>
            <text class="comment-text">{{cm.content}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部占位 -->
    <view class="bottom-spacer"></view>
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar" wx:if="{{!loading && post}}">
    <view class="bar-actions">
      <!-- 点赞按钮 -->
      <view class="bar-btn {{post.liked ? 'liked' : ''}}" bindtap="toggleLike">
        <text>{{post.liked ? '❤' : '🤍'}}</text>
        <text wx:if="{{post.likers && post.likers.length > 0}}" class="bar-count">{{post.likers.length}}</text>
      </view>
    </view>
    <view class="bar-input-area">
      <view class="reply-hint" wx:if="{{replyToName}}" bindtap="cancelReply">
        <text>回复 {{replyToName}}</text>
        <text class="cancel-reply">✕</text>
      </view>
      <textarea class="bar-input" placeholder="{{replyToName ? '回复' + replyToName + '：' : '说点什么…'}}" value="{{commentText}}" bindinput="onCommentInput" auto-height maxlength="-1" confirm-type="send" bindconfirm="sendComment"></textarea>
      <view class="bar-send {{canSend ? 'active' : ''}}" bindtap="sendComment">→</view>
    </view>
  </view>
</view>

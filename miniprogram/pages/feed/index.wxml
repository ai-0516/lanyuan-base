<view class="feed-page">
  <!-- 滚动内容区 -->
  <scroll-view class="post-list-scroll" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-triggered="{{refresherTriggered}}" bindrefresherrefresh="onPullDownRefresh" bindscrolltolower="onLoadMore">

  <!-- 加载中 -->
  <view class="loading-placeholder" wx:if="{{loading && posts.length === 0}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && posts.length === 0}}">
    <image class="empty-icon" src="/images/empty-icon.png" mode="aspectFit"></image>
    <text class="empty-text">暂无帖子，快来发布第一条吧</text>
  </view>

  <!-- 帖子列表 -->
  <view class="post-list" wx:if="{{posts.length > 0}}" bindtap="closeActions">
    <post-card
      wx:for="{{posts}}" wx:key="id"
      post="{{item}}"
      currentUserId="{{currentUserId}}"
      actionOpenId="{{actionOpenId}}"
      bind:like="onPostLike"
      bind:toggleactions="onPostToggleActions"
      bind:comment="onPostComment"
      bind:tapcomment="onPostTapComment"
      bind:previewimage="onPostPreviewImage"
      bind:delete="onPostDelete"
    />

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loadingMore}}">
      <text class="load-more-text">加载中...</text>
    </view>
    <view class="no-more" wx:if="{{!hasMore && posts.length > 0}}">
      <text class="no-more-text">— 没有更多了 —</text>
    </view>
  </view>
  </scroll-view>

  <!-- 浮动发布按钮（固定在右下角） -->
  <view class="fab" bindtap="goToCreatePost">
    <text class="fab-icon">+</text>
  </view>

  <!-- 评论弹窗 -->
  <view class="comment-overlay {{commentSheetOpen ? 'show' : ''}}" bindtap="closeCommentSheet"></view>
  <view class="comment-sheet {{commentSheetOpen ? 'show' : ''}}">
    <!-- 输入区 -->
    <view class="cs-input-area">
      <textarea class="cs-input" placeholder="{{replyToName ? '回复' + replyToName + '：' : '说点什么…'}}" value="{{commentText}}" bindinput="onCommentInput" auto-height></textarea>
      <view class="cs-send {{canSend ? 'active' : ''}}" bindtap="sendComment">→</view>
    </view>
  </view>
</view>

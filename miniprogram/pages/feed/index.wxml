<view class="feed-page">
  <!-- 滚动内容区 -->
  <scroll-view class="post-list-scroll" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-triggered="{{refresherTriggered}}" bindrefresherrefresh="onPullDownRefresh" bindscrolltolower="onLoadMore">

  <!-- 加载中 -->
  <view class="loading-placeholder" wx:if="{{loading && posts.length === 0}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && posts.length === 0}}">
    <image class="empty-icon" src="/images/empty-icon.png" mode="aspectFit"></image>
    <text class="empty-text">暂无帖子，快来发布第一条吧</text>
  </view>

  <!-- 帖子列表 -->
  <view class="post-list" wx:if="{{posts.length > 0}}">
    <view class="feed-post" wx:for="{{posts}}" wx:key="id">
      <!-- 帖子头部 -->
      <view class="post-left">
        <image class="post-avatar" src="{{item.displayAvatar}}" mode="aspectFill" bindtap="goToProfile" data-user-id="{{item.user.id}}"></image>
      </view>
      <view class="post-right">
        <view class="feed-header">
          <text class="feed-user">{{item.user.nickname}}</text>
          <text class="feed-meta">{{item.displayTime}}</text>
        </view>

        <!-- 帖子正文 -->
        <view class="feed-body">{{item.content}}</view>

        <!-- 图片网格 -->
        <view class="feed-images count-{{item.images.length}}" wx:if="{{item.images && item.images.length > 0}}">
          <image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="aspectFill" bindtap="openLightbox" data-images="{{item.images}}" data-index="{{index}}"></image>
        </view>

        <!-- 操作栏 -->
        <view class="feed-actions {{actionOpenId === 'fa-' + item.id ? 'open' : ''}}" id="fa-{{item.id}}">
          <text class="action-left">{{item.displayTime}}</text>
          <view class="action-slide">
            <view class="slide-btn {{item.liked ? 'liked' : ''}}" bindtap="toggleLike" data-post-id="{{item.id}}" data-fa-id="fa-{{item.id}}">
              <image class="slide-icon" src="{{item.liked ? '/images/liked-icon.png' : '/images/like-icon.png'}}" mode="aspectFit"></image>
              <text>{{item.liked ? '取消点赞' : '点赞'}}</text>
            </view>
            <view class="slide-btn" bindtap="openCommentSheet" data-post-id="{{item.id}}" data-comment-count="{{item.comment_count}}">
              <image class="slide-icon" src="/images/comment-icon.png" mode="aspectFit"></image>
              <text>评论</text>
            </view>
          </view>
          <text class="action-dots" bindtap="toggleActions" data-fa-id="fa-{{item.id}}">⋯</text>
        </view>

        <!-- 点赞用户名单 -->
        <view class="likers-row" wx:if="{{item.likers && item.likers.length > 0}}">
          <image class="like-icon-small" src="/images/liked-icon.png" mode="aspectFit"></image>
          <text class="likers-text">{{item.likersText}}</text>
        </view>

        <!-- 评论预览 -->
        <view class="comment-preview" wx:if="{{item.displayComments && item.displayComments.length > 0}}">
          <view class="comment-inline" wx:for="{{item.displayComments}}" wx:key="id">
            <view class="ci-body">
              <text class="ci-author">{{item.user.nickname}}</text>
              <text wx:if="{{item.reply_to}}" class="ci-reply">回复</text>
              <text wx:if="{{item.reply_to}}" class="ci-reply-name">{{item.reply_to.nickname}}</text>
              <text wx:if="{{item.reply_to}}" class="ci-reply">：</text>
              <text class="ci-text">{{item.content}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loadingMore}}">
      <text class="load-more-text">加载中...</text>
    </view>
    <view class="no-more" wx:if="{{!hasMore && posts.length > 0}}">
      <text class="no-more-text">— 没有更多了 —</text>
    </view>
  </view>
  </scroll-view>

  <!-- 浮动发布按钮（固定在右下角） -->
  <view class="fab" bindtap="goToCreatePost">
    <text class="fab-icon">+</text>
  </view>

  <!-- 评论弹窗 -->
  <view class="comment-overlay {{commentSheetOpen ? 'show' : ''}}" bindtap="closeCommentSheet"></view>
  <view class="comment-sheet {{commentSheetOpen ? 'show' : ''}}">
    <!-- 输入区 -->
    <view class="cs-input-area">
      <textarea class="cs-input" placeholder="说点什么…" value="{{commentText}}" bindinput="onCommentInput"></textarea>
      <view class="cs-send {{canSend ? 'active' : ''}}" bindtap="sendComment">→</view>
    </view>
  </view>
</view>

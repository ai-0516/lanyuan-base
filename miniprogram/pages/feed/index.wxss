/* 发现页样式 */
@import '../../styles/variables.wxss';

.feed-page {
  min-height: 100vh;
  background: #f5f0eb;
  position: relative;
}

/* 顶部导航 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 32rpx 20rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3d2b1f;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.nav-icon {
  width: 44rpx;
  height: 44rpx;
}

/* 帖子列表容器 */
.post-list {
  height: calc(100vh - 140rpx);
  padding: 20rpx 24rpx 120rpx;
  box-sizing: border-box;
}

/* 加载中占位 */
.loading-placeholder {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #a09184;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 600rpx;
}

.empty-icon {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #a09184;
}

/* 帖子卡片 */
.post-card {
  background: #fefcf8;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(61, 43, 31, 0.06);
}

/* 帖子头部 */
.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #e8ddd5;
}

.post-meta {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.post-time {
  font-size: 22rpx;
  color: #a09184;
  margin-top: 4rpx;
}

/* 帖子正文 */
.post-content {
  font-size: 28rpx;
  color: #4a3729;
  line-height: 1.6;
  margin-bottom: 20rpx;
  word-break: break-word;
}

/* 底部操作栏 */
.post-actions {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0e8e0;
  margin-top: 16rpx;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
}

.action-text {
  font-size: 24rpx;
  color: #8a7a6c;
}

/* 点赞用户名单 */
.likers-list {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 16rpx;
  padding: 12rpx 0;
}

.like-icon-small {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.likers-text {
  font-size: 22rpx;
  color: #c4673c;
  line-height: 1.4;
}

/* 评论列表 */
.comments-section {
  margin-top: 12rpx;
  padding: 16rpx 0 8rpx;
  background: #f8f4ef;
  border-radius: 12rpx;
  padding: 16rpx;
}

.comment-item {
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 10rpx;
  word-break: break-word;
}

.comment-author {
  font-weight: 600;
  color: #3d2b1f;
}

.comment-prefix {
  color: #8a7a6c;
  font-size: 24rpx;
}

.comment-content {
  color: #4a3729;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.load-more-text {
  font-size: 26rpx;
  color: #a09184;
}

.no-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #c4b8ad;
}

/* 浮动发布按钮 (FAB) */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 100rpx;
  width: 100rpx;
  height: 100rpx;
  background: #c4673c;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(196, 103, 60, 0.35);
  z-index: 200;
}

.fab:active {
  opacity: 0.85;
  transform: scale(0.93);
}

.fab-icon {
  font-size: 56rpx;
  color: #fff;
  line-height: 1;
  margin-top: -4rpx;
}

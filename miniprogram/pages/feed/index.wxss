/* 发现页 — 对齐 v3-social-feed.html 设计稿 */
.feed-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--cream);
}
/* 滚动内容区填充剩余高度 */
.post-list-scroll {
  flex: 1;
  overflow-y: scroll;
}
/* 隐藏滚动条 */
.post-list-scroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}
page {
  overflow: hidden;
}
page::-webkit-scrollbar {
  display: none;
}

/* 帖子列表容器 */
.post-list {
  padding: 0 24rpx 120rpx;
}

/* 加载中占位 */
.loading-placeholder {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}
.loading-text {
  font-size: 28rpx;
  color: #b8a898;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 600rpx;
}
.empty-icon {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}
.empty-text {
  font-size: 28rpx;
  color: #b8a898;
}

/* Feed 帖子 — 对齐设计稿 */
.feed-post {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0 8rpx;
  border-bottom: 1rpx solid rgba(232, 213, 192, 0.4);
}
.post-left {
  flex-shrink: 0;
}
.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: block;
  background: var(--sand);
}
.post-right {
  flex: 1;
  min-width: 0;
}

/* 帖子头部 */
.feed-header {
  margin-bottom: 8rpx;
}
.feed-user {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--bark);
}
.feed-meta {
  font-size: 22rpx;
  color: #b8a898;
  margin-top: 2rpx;
}

/* 帖子正文 */
.feed-body {
  font-size: 26rpx;
  line-height: 1.6;
  color: #5c4a3a;
  margin-bottom: 16rpx;
  word-break: break-word;
}

/* 图片网格 — 对齐设计稿 grid 布局 */
.feed-images {
  display: grid;
  gap: 4rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
}
.feed-images image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.feed-images.count-1 {
  grid-template-columns: 1fr;
}
.feed-images.count-1 image {
  aspect-ratio: 16/9;
}
.feed-images.count-2 {
  grid-template-columns: 1fr 1fr;
}
.feed-images.count-2 image {
  aspect-ratio: 1/1;
}
.feed-images.count-3 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto auto;
}
.feed-images.count-3 image:first-child {
  grid-column: 1 / -1;
  aspect-ratio: 16/9;
}
.feed-images.count-3 image:nth-child(2),
.feed-images.count-3 image:nth-child(3) {
  aspect-ratio: 1/1;
}
.feed-images.count-4 {
  grid-template-columns: 1fr 1fr;
}
.feed-images.count-4 image {
  aspect-ratio: 1/1;
}
.feed-images.count-5,
.feed-images.count-6,
.feed-images.count-7,
.feed-images.count-8,
.feed-images.count-9 {
  grid-template-columns: 1fr 1fr 1fr;
}
.feed-images.count-5 image,
.feed-images.count-6 image,
.feed-images.count-7 image,
.feed-images.count-8 image,
.feed-images.count-9 image {
  aspect-ratio: 1/1;
}

/* ── 操作栏（对齐设计稿: 时间左 · dots 右 · 滑出面板） ── */
.feed-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #b8a898;
  padding-top: 4rpx;
  position: relative;
  min-height: 48rpx;
}
.action-left {
  font-size: 22rpx;
  color: #b8a898;
}

/* 滑出操作面板（默认隐藏，点击 dots 后滑入） */
.action-slide {
  display: flex;
  gap: 24rpx;
  align-items: center;
  position: absolute;
  right: 40rpx;
  top: 2rpx;
  transform: translateX(32rpx);
  transition: transform 0.25s ease, opacity 0.25s;
  z-index: 10;
  opacity: 0;
  visibility: hidden;
  background: var(--warm-white);
  border-radius: 20rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(61, 43, 31, 0.1);
  border: 1rpx solid rgba(232, 213, 192, 0.3);
}
.feed-actions.open .action-slide {
  transform: translateX(0);
  opacity: 1;
  visibility: visible;
}

.slide-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #b8a898;
  transition: color 0.2s;
  white-space: nowrap;
}
.slide-btn:active {
  color: var(--terracotta);
}
.slide-btn.liked {
  color: var(--terracotta);
}
.slide-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 三点菜单按钮 */
.action-dots {
  font-size: 36rpx;
  color: #b8a898;
  line-height: 1;
  padding: 4rpx 8rpx;
  letter-spacing: 4rpx;
  z-index: 2;
  position: relative;
}
.action-dots:active {
  color: var(--terracotta);
}

/* ── 点赞名单 ── */
.likers-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  padding: 8rpx 0;
}
.like-icon-small {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.likers-text {
  font-size: 22rpx;
  color: var(--terracotta);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 评论预览区 ── */
.post-section {
  background: #f8f2e9;
  border-radius: 24rpx;
  padding: 16rpx;
  margin-top: 12rpx;
}
.comment-inline {
  display: flex;
  gap: 8rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
.ci-body {
  flex: 1;
  min-width: 0;
}
.ci-author {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--terracotta);
  display: inline;
}
.ci-reply {
  font-size: 24rpx;
  color: #b8a898;
  display: inline;
}
.ci-reply-name {
  color: var(--terracotta);
  font-size: 24rpx;
  font-weight: 600;
  display: inline;
}
.ci-text {
  font-size: 24rpx;
  color: #7a6a5a;
  display: inline;
}
.comment-more {
  font-size: 24rpx;
  color: var(--terracotta);
  padding: 8rpx 0 0;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}
.load-more-text {
  font-size: 26rpx;
  color: #b8a898;
}
.no-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}
.no-more-text {
  font-size: 24rpx;
  color: #c8b8a8;
}

/* 浮动发布按钮 (FAB) */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, var(--ember), var(--clay));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(61, 43, 31, 0.1), 0 4rpx 12rpx rgba(61, 43, 31, 0.05);
  z-index: 200;
}
.fab:active {
  opacity: 0.85;
  transform: scale(0.93);
}
.fab-icon {
  font-size: 56rpx;
  color: #fff;
  line-height: 1;
  margin-top: -6rpx;
}

/* ── 评论弹窗 ── */
.comment-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}
.comment-overlay.show {
  opacity: 1;
  pointer-events: auto;
}
.comment-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--warm-white);
  border-radius: 24rpx 24rpx 0 0;
  z-index: 201;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -8rpx 32rpx rgba(61, 43, 31, 0.12);
}
.comment-sheet.show {
  transform: translateY(0);
}
.cs-input-area {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx 40rpx;
  border-top: 1rpx solid rgba(232, 213, 192, 0.3);
  flex-shrink: 0;
  background: var(--warm-white);
}
.cs-input {
  flex: 1;
  min-height: 64rpx;
  max-height: 200rpx;
  background: #f8f2e9;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #3d2b1f;
  line-height: 1.5;
}
.cs-send {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e8d5c0;
  color: #8c7a68;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  line-height: 64rpx;
  text-align: center;
  padding: 0;
  transition: all 0.2s;
}
.cs-send.active {
  background: linear-gradient(135deg, var(--terracotta-light), var(--terracotta));
  color: #fff;
}

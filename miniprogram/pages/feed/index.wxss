/* 发现页 — 帖子样式在 post-card 组件中 */

.feed-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--cream);
}
.post-list-scroll {
  flex: 1;
  overflow-y: scroll;
}
.post-list-scroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}
page {
  overflow: hidden;
}
page::-webkit-scrollbar {
  display: none;
}

/* 帖子列表容器 */
.post-list {
  padding: 0 24rpx 120rpx;
}

/* 加载中 */
.loading-placeholder {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}
.loading-text {
  font-size: 28rpx;
  color: #b8a898;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 600rpx;
}
.empty-icon {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}
.empty-text {
  font-size: 28rpx;
  color: #b8a898;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}
.load-more-text {
  font-size: 26rpx;
  color: #b8a898;
}
.no-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}
.no-more-text {
  font-size: 24rpx;
  color: #c8b8a8;
}

/* 浮动发布按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 60rpx;
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, var(--ember), var(--clay));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(61, 43, 31, 0.1), 0 4rpx 12rpx rgba(61, 43, 31, 0.05);
  z-index: 200;
}
.fab:active {
  opacity: 0.85;
  transform: scale(0.93);
}
.fab-icon {
  font-size: 56rpx;
  color: #fff;
  line-height: 1;
  margin-top: -6rpx;
}

/* 评论弹窗 */
.comment-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(61, 43, 31, 0.3);
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}
.comment-overlay.show {
  opacity: 1;
  pointer-events: auto;
}
.comment-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--warm-white);
  border-radius: 32rpx 32rpx 0 0;
  z-index: 201;
  padding: 32rpx 32rpx 48rpx;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -8rpx 48rpx rgba(61, 43, 31, 0.1);
}
.comment-sheet.show {
  transform: translateY(0);
}
.cs-input-area {
  display: flex;
  gap: 16rpx;
  align-items: center;
  background: var(--cream);
  border-radius: 32rpx;
  padding: 12rpx;
  min-height: 96rpx;
}
.cs-input {
  flex: 1;
  background: transparent;
  border-radius: 0;
  padding: 8rpx 16rpx;
  font-size: 28rpx;
  color: var(--bark);
  line-height: 1.5;
  border: none;
  max-height: 200rpx;
}
.cs-send {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #d8c8b8;
  color: #fff;
  border: none;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 72rpx;
  text-align: center;
  padding: 0;
  transition: transform 0.2s, background 0.2s;
}
.cs-send:active {
  transform: scale(0.92);
}
.cs-send.active {
  background: linear-gradient(135deg, var(--ember), var(--clay));
  color: #fff;
}

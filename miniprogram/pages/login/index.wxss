/* 登录页 — 对齐 v3-login.html 设计稿 */
.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background: linear-gradient(135deg, #f5d6c6 0%, #e8b8a0 30%, #d4947a 60%, #c4673c 100%);
  position: relative;
  overflow: hidden;
  padding: 0 60rpx;
  box-sizing: border-box;
}

/* 背景装饰圆 */
.bg-decor {
  position: absolute;
  border-radius: 50%;
  opacity: 0.1;
  background: #fff;
}
.top-decor {
  width: 600rpx;
  height: 600rpx;
  top: -200rpx;
  right: -150rpx;
}
.bottom-decor {
  width: 500rpx;
  height: 500rpx;
  bottom: -180rpx;
  left: -100rpx;
}

/* 品牌区域 */
.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 140rpx;
  margin-bottom: 60rpx;
}

.app-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(61, 43, 31, 0.1);
}
.app-icon-text {
  color: #fff;
  font-size: 52rpx;
  font-weight: 700;
}

.app-name-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}
.app-name-serif {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(61, 43, 31, 0.1);
}
.app-name-accent {
  font-size: 48rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(61, 43, 31, 0.1);
}

.app-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
  letter-spacing: 2rpx;
}

/* ── 头像 + 昵称 ── */
.profile-setup {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
  margin-bottom: 80rpx;
}

/* 头像 */
.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.avatar-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.15);
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
}
.avatar-btn-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  opacity: 0;
}
.avatar-btn-overlay::after {
  border: none;
}
.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-icon {
  font-size: 56rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
  line-height: 1;
}
.avatar-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 1rpx;
}

/* 昵称 */
.nickname-wrap {
  width: 100%;
  max-width: 320rpx;
  text-align: center;
}
.nickname-input {
  width: 100%;
  font-size: 32rpx;
  color: #fff;
  text-align: center;
  border: none;
  background: transparent;
  padding: 12rpx 0;
  caret-color: #fff;
}
.nickname-input::placeholder {
  color: rgba(255, 255, 255, 0.45);
  font-size: 30rpx;
}
.input-underline {
  width: 60%;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.2);
  margin: 0 auto;
  transition: width 0.3s;
}
.nickname-input:focus + .input-underline {
  width: 100%;
  background: rgba(255, 255, 255, 0.5);
}

/* 登录按钮 */
.login-btn-wrapper {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wx-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 360rpx;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 48rpx;
  border: none;
  padding: 0;
  font-size: 32rpx;
  color: #8b5a40;
  font-weight: 600;
  box-shadow: 0 12rpx 32rpx rgba(61, 43, 31, 0.1);
  transition: all 0.2s;
}
.wx-login-btn::after {
  border: none;
}
.wx-login-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}
.wx-login-btn[disabled] {
  opacity: 0.5;
}

.wx-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.agreement-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 36rpx;
  text-align: center;
}

/* 自动登录 loading */
.loading-splash {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  gap: 40rpx;
}
.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

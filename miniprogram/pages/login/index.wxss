/* 登录页样式 */
@import '../../styles/variables.wxss';

.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: linear-gradient(135deg, #f5d6c6 0%, #e8b8a0 30%, #d4947a 60%, #c4673c 100%);
  position: relative;
  overflow: hidden;
  padding: 0 60rpx;
  box-sizing: border-box;
}

/* 背景装饰圆 */
.bg-decor {
  position: absolute;
  border-radius: 50%;
  opacity: 0.1;
  background: #fff;
}
.top-decor {
  width: 600rpx;
  height: 600rpx;
  top: -200rpx;
  right: -150rpx;
}
.bottom-decor {
  width: 500rpx;
  height: 500rpx;
  bottom: -180rpx;
  left: -100rpx;
}

/* 品牌区域 */
.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.app-logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
}

.app-name {
  font-size: 56rpx;
  font-weight: 700;
  color: #3d2b1f;
  letter-spacing: 8rpx;
  margin-bottom: 20rpx;
}

.app-desc {
  font-size: 28rpx;
  color: #5c4033;
  opacity: 0.8;
  letter-spacing: 2rpx;
}

/* 登录按钮 */
.login-btn-wrapper {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wx-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  background: #c4673c;
  border-radius: 48rpx;
  border: none;
  padding: 0;
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(196, 103, 60, 0.4);
  transition: all 0.3s ease;
}

.wx-login-btn::after {
  border: none;
}

.wx-login-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.wx-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.agreement-text {
  font-size: 24rpx;
  color: #5c4033;
  opacity: 0.6;
  margin-top: 36rpx;
  text-align: center;
}

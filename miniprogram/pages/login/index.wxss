/* 登录页 — 对齐 v3-login.html 设计稿 */
.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: linear-gradient(135deg, #f5d6c6 0%, #e8b8a0 30%, #d4947a 60%, #c4673c 100%);
  position: relative;
  overflow: hidden;
  padding: 0 60rpx;
  box-sizing: border-box;
}

/* 背景装饰圆 */
.bg-decor {
  position: absolute;
  border-radius: 50%;
  opacity: 0.1;
  background: #fff;
}
.top-decor {
  width: 600rpx;
  height: 600rpx;
  top: -200rpx;
  right: -150rpx;
}
.bottom-decor {
  width: 500rpx;
  height: 500rpx;
  bottom: -180rpx;
  left: -100rpx;
}

/* 品牌区域 */
.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.app-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, var(--terracotta-light), var(--terracotta));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  box-shadow: 0 24rpx 64rpx rgba(61, 43, 31, 0.1), 0 8rpx 24rpx rgba(61, 43, 31, 0.05);
}
.app-icon-text {
  color: #fff;
  font-size: 60rpx;
  font-weight: 700;
}

.app-name-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}
.app-name-serif {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--bark);
  letter-spacing: 4rpx;
}
.app-name-accent {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--terracotta-deep);
  letter-spacing: 4rpx;
}

.app-desc {
  font-size: 28rpx;
  color: #5c4033;
  opacity: 0.8;
  letter-spacing: 2rpx;
}

/* 登录按钮 */
.login-btn-wrapper {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wx-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #d4744b, #b8532e);
  border-radius: 48rpx;
  border: none;
  padding: 0;
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
  box-shadow: 0 12rpx 32rpx rgba(61, 43, 31, 0.1), 0 4rpx 12rpx rgba(61, 43, 31, 0.05);
  transition: all 0.2s;
}
.wx-login-btn::after {
  border: none;
}
.wx-login-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.wx-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

/* 微信信息卡片 */
.info-section {
  width: 100%;
  margin-bottom: 60rpx;
}
.info-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 20rpx 32rpx;
}
.avatar-row,
.nickname-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}
.nickname-row {
  border-top: 1rpx solid rgba(232, 213, 192, 0.3);
}
.info-label {
  font-size: 28rpx;
  color: var(--bark);
  font-weight: 500;
  flex-shrink: 0;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  line-height: 0;
  position: relative;
}
.avatar-btn::after {
  border: none;
}
.avatar-preview {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: block;
  background: #f0e8e0;
}
.avatar-hint {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #b8a898;
  line-height: 1.2;
  text-align: center;
}

.nickname-input {
  font-size: 28rpx;
  color: var(--bark);
  text-align: right;
  width: 360rpx;
  border: none;
  background: transparent;
}

.agreement-text {
  font-size: 22rpx;
  color: #5c4033;
  opacity: 0.6;
  margin-top: 36rpx;
  text-align: center;
}

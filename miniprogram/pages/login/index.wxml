<view class="login-page">
  <!-- 自动登录中 -->
  <view class="loading-splash" wx:if="{{!checked}}">
    <view class="app-icon">
      <text class="app-icon-text">兰</text>
    </view>
    <text class="loading-text">正在登录...</text>
  </view>

  <!-- 登录界面 -->
  <block wx:else>
  <view class="bg-decor top-decor"></view>
  <view class="bg-decor bottom-decor"></view>

  <!-- 品牌区域 -->
  <view class="brand-section">
    <view class="app-icon">
      <text class="app-icon-text">兰</text>
    </view>
    <view class="app-name-row">
      <text class="app-name-serif">东方</text>
      <text class="app-name-accent">兰园</text>
    </view>
    <text class="app-desc">你的社区生活好帮手</text>
  </view>

  <!-- 头像 + 昵称 -->
  <view class="profile-setup">
    <view class="avatar-wrap">
      <view class="avatar-circle">
        <image class="avatar-img" src="{{avatar || ''}}" mode="aspectFill" wx:if="{{avatar}}"></image>
        <button class="avatar-btn-overlay" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"></button>
      </view>
      <text class="avatar-label">点击设置头像</text>
    </view>
    <view class="nickname-wrap">
      <input type="nickname" class="nickname-input" id="e2e-login-nickname" placeholder="你的昵称" value="{{nickname}}" bindinput="onNicknameInput" maxlength="20" />
      <view class="input-underline"></view>
    </view>
  </view>

  <!-- 登录按钮 -->
  <view class="login-btn-wrapper">
    <button class="wx-login-btn" wx:if="{{needPrivacyAuthorization}}" id="e2e-login-submit" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onAgreePrivacyAuthorization" loading="{{logging}}" disabled="{{logging || !nickname || !avatar || !privacyAccepted}}">
      <image class="wx-icon" src="/images/wechat-icon.png" mode="aspectFit"></image>
      <text>登录</text>
    </button>
    <button class="wx-login-btn" wx:else id="e2e-login-submit" bindtap="handleWxLogin" loading="{{logging}}" disabled="{{logging || !nickname || !avatar || !privacyAccepted}}">
      <image class="wx-icon" src="/images/wechat-icon.png" mode="aspectFit"></image>
      <text>登录</text>
    </button>
    <view class="agreement-text">
      <checkbox-group class="agreement-check" bindchange="onPrivacyAgreementChange">
        <label class="agreement-label">
          <checkbox class="agreement-checkbox" value="accepted" checked="{{privacyAccepted}}" color="#c4673c" />
          <text>我已阅读并同意</text>
        </label>
      </checkbox-group>
      <text class="agreement-link" bindtap="onOpenPrivacyContract">{{privacyContractName}}</text>
    </view>
  </view>
  </block>
</view>

<view class="login-page">
  <!-- 自动登录中 -->
  <view class="loading-splash" wx:if="{{!checked}}">
    <view class="app-icon">
      <text class="app-icon-text">兰</text>
    </view>
    <text class="loading-text">正在登录...</text>
  </view>

  <!-- 登录界面 -->
  <block wx:else>
  <view class="bg-decor top-decor"></view>
  <view class="bg-decor bottom-decor"></view>

  <!-- 品牌区域 -->
  <view class="brand-section">
    <view class="app-icon">
      <text class="app-icon-text">兰</text>
    </view>
    <view class="app-name-row">
      <text class="app-name-serif">东方</text>
      <text class="app-name-accent">兰园</text>
    </view>
    <text class="app-desc">你的社区生活好帮手</text>
  </view>

  <!-- 头像 + 昵称 -->
  <view class="profile-setup">
    <view class="avatar-wrap">
      <view class="avatar-circle">
        <image class="avatar-img" src="{{avatar || ''}}" mode="aspectFill" wx:if="{{avatar}}"></image>
        <button class="avatar-btn-overlay" wx:if="{{needPrivacyAuthorization}}" bindtap="onPrivacyRequiredAction"></button>
        <button class="avatar-btn-overlay" wx:else open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"></button>
      </view>
      <text class="avatar-label">点击设置头像</text>
    </view>
    <view class="nickname-wrap">
      <view class="nickname-input privacy-nickname" wx:if="{{needPrivacyAuthorization}}" bindtap="onPrivacyRequiredAction">{{nickname || '你的昵称'}}</view>
      <input wx:else type="nickname" class="nickname-input" id="e2e-login-nickname" placeholder="你的昵称" value="{{nickname}}" bindinput="onNicknameInput" maxlength="20" />
      <view class="input-underline"></view>
    </view>
  </view>

  <!-- 登录按钮 -->
  <view class="login-btn-wrapper">
    <button class="wx-login-btn" id="e2e-login-submit" bindtap="handleWxLogin" loading="{{logging}}" disabled="{{logging || !nickname || !avatar}}">
      <image class="wx-icon" src="/images/wechat-icon.png" mode="aspectFit"></image>
      <text>登录</text>
    </button>
    <view class="agreement-text">登录即表示已阅读并同意<text class="agreement-link" bindtap="onOpenPrivacyContract">{{privacyContractName}}</text></view>
  </view>
  </block>

  <view class="privacy-mask" wx:if="{{showPrivacyAuthorization}}">
    <view class="privacy-dialog">
      <text class="privacy-title">隐私保护提示</text>
      <view class="privacy-content">在使用前，请阅读并同意<text class="privacy-link" bindtap="onOpenPrivacyContract">{{privacyContractName}}</text>。同意后方可使用头像、昵称等相关功能。</view>
      <button class="privacy-agree" id="privacy-agree-btn" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onAgreePrivacyAuthorization">同意并继续</button>
    </view>
  </view>
</view>

page {
  background: var(--cream);
}
.page-content {
  padding: 40rpx 24rpx;
}
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}
.hero-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}
.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--bark);
}
.hero-version {
  font-size: 24rpx;
  color: #b8a898;
  margin-top: 8rpx;
}
.section {
  background: var(--warm-white);
  border-radius: 32rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(232, 213, 192, 0.4);
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(232, 213, 192, 0.3);
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  font-size: 28rpx;
  color: var(--bark);
}
.info-value {
  font-size: 26rpx;
  color: #b8a898;
}
.desc-text {
  font-size: 26rpx;
  color: #5c4a3a;
  line-height: 1.8;
}

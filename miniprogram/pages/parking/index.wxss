page {
  overflow: hidden;
  background: var(--cream);
}

.parking-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: calc(50px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--cream);
}

.search-area {
  position: relative;
  z-index: 30;
  padding: 20rpx 24rpx;
  background: var(--warm-white);
  box-shadow: 0 4rpx 16rpx rgba(61, 43, 31, 0.05);
}

.search-box {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--cream);
  border-radius: 24rpx;
}

.search-icon {
  margin-right: 14rpx;
  color: #9c8f84;
  font-size: 42rpx;
  line-height: 1;
  transform: rotate(-20deg);
}

.search-input {
  flex: 1;
  height: 80rpx;
  color: var(--bark);
  font-size: 28rpx;
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  color: #9c8f84;
  font-size: 40rpx;
}

.search-results {
  position: absolute;
  top: 108rpx;
  left: 24rpx;
  right: 24rpx;
  max-height: 620rpx;
  overflow-y: auto;
  background: var(--warm-white);
  border-radius: 0 0 24rpx 24rpx;
  box-shadow: 0 18rpx 40rpx rgba(61, 43, 31, 0.14);
}

.result-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  margin: 0 24rpx;
  border-bottom: 1rpx solid rgba(61, 43, 31, 0.08);
}

.result-type {
  flex: none;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  color: var(--terracotta-deep);
  background: var(--sand);
  font-size: 22rpx;
}

.result-type-building { color: #537548; background: #e4eddc; }
.result-type-gate { color: #7c6535; background: #f3e8c9; }

.result-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.result-title { color: var(--bark); font-size: 28rpx; }
.result-subtitle { margin-top: 4rpx; color: #9c8f84; font-size: 22rpx; }
.result-locate { color: var(--terracotta); font-size: 24rpx; }
.result-empty, .result-limit { padding: 30rpx 24rpx; color: #9c8f84; text-align: center; font-size: 24rpx; }
.result-limit { padding: 18rpx 24rpx; }

.map-viewport {
  position: relative;
  flex: 1;
  width: 100%;
  height: auto;
  overflow: hidden;
  background: #fff;
}

.map-layer { position: relative; }
.parking-map { display: block; width: 100%; height: 100%; }

.route-segment {
  position: absolute;
  z-index: 3;
  height: 7rpx;
  margin-top: -3.5rpx;
  background: #2d83e5;
  border-radius: 999rpx;
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.92);
  transform-origin: 0 50%;
}

.route-marker {
  position: absolute;
  z-index: 6;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  box-sizing: border-box;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  transform: translate(-50%, -50%);
  box-shadow: 0 3rpx 10rpx rgba(44, 38, 32, 0.28);
}

.route-marker-start { background: #4d8b57; }
.route-marker-end { background: var(--terracotta); }

.target-marker {
  position: absolute;
  z-index: 5;
  display: flex;
  align-items: center;
  transform: translate(-50%, -50%);
}

.marker-dot {
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid var(--terracotta);
  border-radius: 50%;
  box-sizing: border-box;
  background: rgba(196, 103, 60, 0.12);
  box-shadow: 0 0 0 2rpx rgba(255, 250, 245, 0.9);
}

.target-marker-building .marker-dot { border-color: var(--olive); background: rgba(107, 142, 90, 0.12); }
.target-marker-gate .marker-dot { border-color: var(--gold); background: rgba(200, 150, 62, 0.12); }

.map-status, .map-loading {
  position: absolute;
  inset: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: #ebe6df;
  color: #9c8f84;
  text-align: center;
}

.status-title { margin-bottom: 16rpx; color: var(--bark); font-size: 30rpx; font-weight: 500; }
.status-text { font-size: 24rpx; line-height: 1.6; }
.map-loading { font-size: 26rpx; }

.map-tools {
  position: absolute;
  z-index: 20;
  right: 24rpx;
  top: 24rpx;
  width: 76rpx;
  overflow: hidden;
  background: rgba(255, 250, 245, 0.94);
  border-radius: 18rpx;
  box-shadow: 0 6rpx 20rpx rgba(61, 43, 31, 0.12);
}

.map-tool {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  color: var(--bark);
  font-size: 40rpx;
}

.tool-divider { height: 1rpx; margin: 0 14rpx; background: rgba(61, 43, 31, 0.12); }

.reset-tool {
  position: absolute;
  z-index: 20;
  right: 24rpx;
  top: 190rpx;
  padding: 16rpx 20rpx;
  color: var(--terracotta-deep);
  background: rgba(255, 250, 245, 0.94);
  border-radius: 18rpx;
  box-shadow: 0 6rpx 20rpx rgba(61, 43, 31, 0.12);
  font-size: 24rpx;
}

.selection-card {
  position: absolute;
  z-index: 20;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: rgba(255, 250, 245, 0.96);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(61, 43, 31, 0.14);
}

.selection-card-raised { bottom: 230rpx; }

.selection-kind { display: block; color: var(--terracotta); font-size: 22rpx; }
.selection-title { display: block; margin-top: 4rpx; color: var(--bark); font-size: 32rpx; font-weight: 500; }
.selection-subtitle { display: block; margin-top: 4rpx; color: #9c8f84; font-size: 22rpx; }

.selection-actions { display: flex; flex-direction: column; gap: 10rpx; margin-left: 20rpx; }
.endpoint-button {
  min-width: 128rpx;
  height: 54rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 27rpx;
  color: #fff;
  font-size: 22rpx;
  line-height: 54rpx;
}
.endpoint-button::after { border: 0; }
.endpoint-button-start { background: #4d8b57; }
.endpoint-button-end { background: var(--terracotta); }

.route-card {
  position: absolute;
  z-index: 20;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: rgba(255, 250, 245, 0.97);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(61, 43, 31, 0.16);
}
.route-endpoints { flex: 1; min-width: 0; }
.route-endpoint-row { display: flex; align-items: center; height: 42rpx; }
.endpoint-badge {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 18rpx;
}
.endpoint-badge-start { background: #4d8b57; }
.endpoint-badge-end { background: var(--terracotta); }
.endpoint-name { overflow: hidden; margin-left: 14rpx; color: var(--bark); font-size: 25rpx; text-overflow: ellipsis; white-space: nowrap; }
.route-endpoint-line { width: 2rpx; height: 14rpx; margin-left: 14rpx; background: #cfc5bc; }
.route-summary { flex: none; margin-left: 20rpx; text-align: right; }
.route-distance { display: block; color: var(--terracotta-deep); font-size: 26rpx; font-weight: 500; }
.route-waiting { display: block; max-width: 190rpx; color: #9c8f84; font-size: 21rpx; }
.route-actions { display: flex; justify-content: flex-end; gap: 20rpx; margin-top: 10rpx; }
.route-action { color: #6b7f61; font-size: 22rpx; }
.route-action-clear { color: #a58878; }

.service-area {
  flex: none;
  height: 184rpx;
  padding: 16rpx 24rpx 20rpx;
  box-sizing: border-box;
  background: var(--warm-white);
  border-top: 1rpx solid rgba(61, 43, 31, 0.07);
}

.service-heading {
  display: block;
  margin-bottom: 12rpx;
  color: #8e8177;
  font-size: 22rpx;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.service-item {
  display: flex;
  align-items: center;
  min-width: 0;
  height: 104rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  background: var(--cream);
  border-radius: 20rpx;
}

.service-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  color: #fff;
  background: var(--terracotta);
  font-size: 27rpx;
  font-weight: 500;
}

.service-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 16rpx;
}

.service-title { color: var(--bark); font-size: 26rpx; font-weight: 500; }
.service-subtitle { margin-top: 4rpx; color: #9c8f84; font-size: 19rpx; }
.service-arrow { flex: none; margin-left: 8rpx; color: #b9ada3; font-size: 34rpx; }

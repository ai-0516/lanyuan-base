page {
  background: var(--cream);
}
.page-content {
  padding: 24rpx;
}
.section {
  background: var(--warm-white);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(232, 213, 192, 0.4);
}
.title-text {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--bark);
}
.update-text {
  font-size: 22rpx;
  color: #b8a898;
  display: block;
  margin-top: 12rpx;
}
.para-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--bark);
  display: block;
  margin-bottom: 16rpx;
}
.para-text {
  font-size: 26rpx;
  color: #5c4a3a;
  line-height: 1.8;
}

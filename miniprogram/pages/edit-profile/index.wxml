<import src="../../styles/variables.wxss" />

<view class="edit-page">
  <!-- 顶部标题栏 -->
  <view class="header">
    <text class="header-title">编辑资料</text>
  </view>

  <!-- 表单区 -->
  <view class="form-container">
    <!-- 头像 -->
    <view class="form-item avatar-item" bindtap="onChooseAvatar">
      <text class="form-label">头像</text>
      <view class="avatar-wrapper">
        <image class="form-avatar" src="{{form.avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
        <text class="change-avatar-hint">点击更换</text>
      </view>
    </view>

    <!-- 昵称 -->
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input
        class="form-input"
        placeholder="请输入昵称"
        value="{{form.nickname}}"
        bindinput="onFieldChange"
        data-field="nickname"
        maxlength="20"
      />
    </view>

    <!-- 小区 -->
    <view class="form-item">
      <text class="form-label">小区</text>
      <input
        class="form-input"
        placeholder="请输入小区名称"
        value="{{form.community}}"
        bindinput="onFieldChange"
        data-field="community"
        maxlength="50"
      />
    </view>

    <!-- 楼号 -->
    <view class="form-item">
      <text class="form-label">楼号</text>
      <input
        class="form-input"
        placeholder="如：3"
        value="{{form.building}}"
        bindinput="onFieldChange"
        data-field="building"
        maxlength="10"
      />
    </view>

    <!-- 单元 -->
    <view class="form-item">
      <text class="form-label">单元</text>
      <input
        class="form-input"
        placeholder="如：1"
        value="{{form.unit}}"
        bindinput="onFieldChange"
        data-field="unit"
        maxlength="10"
      />
    </view>

    <!-- 房号 -->
    <view class="form-item">
      <text class="form-label">房号</text>
      <input
        class="form-input"
        placeholder="如：501"
        value="{{form.room}}"
        bindinput="onFieldChange"
        data-field="room"
        maxlength="10"
      />
    </view>

    <!-- 个性签名 -->
    <view class="form-item">
      <text class="form-label">个性签名</text>
      <input
        class="form-input"
        placeholder="介绍一下自己..."
        value="{{form.bio}}"
        bindinput="onFieldChange"
        data-field="bio"
        maxlength="100"
      />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-area">
    <button class="save-btn" bindtap="onSave" disabled="{{isSaving}}">
      {{isSaving ? '保存中...' : '保存'}}
    </button>
  </view>
</view>

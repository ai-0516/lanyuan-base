<view class="edit-page">
  <view class="page-content">
    <!-- 头像 + 昵称 -->
    <view class="section">
      <view class="field">
        <text class="field-label">头像</text>
        <view class="field-value">
          <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image class="avatar-sm" src="{{form.avatar || ''}}" mode="aspectFill"></image>
          </button>
          <text class="arrow">›</text>
        </view>
      </view>
      <view class="field">
        <text class="field-label">昵称</text>
        <view class="field-value">
          <input type="nickname" value="{{form.nickname}}" placeholder="请输入昵称" bindinput="onFieldChange" data-field="nickname" maxlength="20"></input>
        </view>
      </view>
    </view>

    <!-- 社区信息 -->
    <view class="section-title">社区信息</view>
    <view class="section">
      <view class="field">
        <text class="field-label">小区</text>
        <view class="field-value">
          <input type="text" value="{{form.community}}" placeholder="请输入小区名称" bindinput="onFieldChange" data-field="community"></input>
        </view>
      </view>
      <view class="field">
        <text class="field-label">楼号</text>
        <view class="field-value">
          <input type="text" value="{{form.building}}" placeholder="请选择" bindinput="onFieldChange" data-field="building"></input>
        </view>
      </view>
      <view class="field">
        <text class="field-label">单元</text>
        <view class="field-value">
          <input type="text" value="{{form.unit}}" placeholder="请选择" bindinput="onFieldChange" data-field="unit"></input>
        </view>
      </view>
      <view class="field">
        <text class="field-label">房号</text>
        <view class="field-value">
          <input type="text" value="{{form.room}}" placeholder="请输入房号" bindinput="onFieldChange" data-field="room"></input>
        </view>
      </view>
    </view>

    <!-- 其他信息 -->
    <view class="section-title">其他信息</view>
    <view class="section">
      <view class="field">
        <text class="field-label">个性签名</text>
        <view class="field-value">
          <textarea placeholder="介绍一下自己吧" value="{{form.bio}}" bindinput="onFieldChange" data-field="bio" auto-height></textarea>
        </view>
      </view>
    </view>

    <!-- 保存按钮 -->
    <view class="save-bar">
      <button class="save-btn" bindtap="onSave" loading="{{isSaving}}" disabled="{{isSaving}}">保存</button>
    </view>
  </view>
</view>

/* 编辑资料 — 对齐 v3-edit-profile.html 设计稿 */
.edit-page {
  min-height: 100vh;
  background: var(--cream);
}

.page-content {
  padding: 0 24rpx 8rpx;
}


/* 分区卡片 */
.section {
  background: var(--warm-white);
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(232, 213, 192, 0.4);
  overflow: hidden;
}

.section-title {
  font-size: 22rpx;
  color: #b8a898;
  padding: 16rpx 8rpx 12rpx;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  font-weight: 500;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(232, 213, 192, 0.3);
  transition: background 0.15s;
}
.field:last-child {
  border-bottom: none;
}
.field:active {
  background: rgba(196, 103, 60, 0.04);
}

.field-label {
  font-size: 28rpx;
  color: var(--bark);
  font-weight: 500;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 80rpx;
}

.field-value {
  font-size: 26rpx;
  color: #b8a898;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.avatar-sm {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: block;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  line-height: 0;
  width: 80rpx;
  height: 80rpx;
}
.avatar-btn::after {
  border: none;
}

.arrow {
  font-size: 28rpx;
  color: #d8c8b8;
}

/* 输入框 */
.field-value input {
  font-size: 28rpx;
  color: var(--bark);
  border: none;
  text-align: left;
  background: transparent;
  width: 360rpx;
  height: 80rpx;
}
.field-value textarea {
  font-size: 26rpx;
  color: var(--bark);
  border: none;
  background: transparent;
  width: 360rpx;
  line-height: 1.5;
  min-height: 48rpx;
}

/* 保存按钮 */
.save-bar {
  padding: 24rpx 0 40rpx;
}
.save-btn {
  width: 100%;
  padding: 28rpx;
  background: linear-gradient(135deg, var(--ember), var(--clay));
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: var(--shadow-md);
}
.save-btn::after {
  border: none;
}
.save-btn:active {
  transform: scale(0.97);
}

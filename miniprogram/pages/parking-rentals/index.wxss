page { background: var(--cream); }
.rental-page { min-height: 100vh; padding: 24rpx 24rpx 60rpx; box-sizing: border-box; }
.hero { display: flex; align-items: center; justify-content: space-between; height: 154rpx; padding: 0 8rpx; box-sizing: border-box; }
.hero-copy { flex: 1; min-width: 0; padding-right: 24rpx; }
.hero-title, .hero-subtitle { display: block; }
.hero-title { color: var(--bark); font-size: 40rpx; font-weight: 600; }
.hero-subtitle { overflow: hidden; margin-top: 8rpx; color: #9c8f84; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.publish-button { display: flex; flex: none; align-items: center; justify-content: center; width: 154rpx; height: 68rpx; margin: 0; padding: 0; box-sizing: border-box; border-radius: 34rpx; color: #fff; background: var(--terracotta); font-size: 25rpx; line-height: normal; }
.publish-button::after { border: 0; }
.listing-tabs { display: flex; margin-bottom: 20rpx; padding: 6rpx; background: #eee5dc; border-radius: 20rpx; }
.listing-tab { display: flex; flex: 1; align-items: center; justify-content: center; height: 66rpx; border-radius: 15rpx; color: #8e8177; font-size: 26rpx; }
.listing-tab-active { color: var(--terracotta-deep); background: var(--warm-white); font-weight: 600; box-shadow: 0 3rpx 10rpx rgba(61,43,31,.08); }
.rental-card { margin-top: 24rpx; margin-bottom: 20rpx; padding: 26rpx; background: var(--warm-white); border-radius: 24rpx; box-shadow: 0 5rpx 18rpx rgba(61,43,31,.06); }
.card-head, .owner-row, .card-actions { display: flex; align-items: center; justify-content: space-between; }
.spot-id { display: block; color: var(--bark); font-size: 38rpx; font-weight: 600; }
.spot-area { display: block; margin-top: 5rpx; color: #9c8f84; font-size: 22rpx; }
.wanted-heading { display: flex; align-items: center; }
.wanted-badge { padding: 5rpx 10rpx; border-radius: 9rpx; color: #fff; background: #6b8e5a; font-size: 20rpx; }
.wanted-title { margin-left: 12rpx; color: var(--bark); font-size: 36rpx; font-weight: 600; }
.wanted-title-suffix { padding-left: 20rpx; color: var(--bark); font-size: 30rpx; font-weight: 600; }
.wanted-card { border-left: 5rpx solid #829d75; }
.description { display: block; margin-top: 20rpx; color: var(--bark); font-size: 27rpx; line-height: 1.6; }
.image-row { width: 100%; margin-top: 20rpx; white-space: nowrap; }
.rental-image-wrap { position: relative; display: inline-block; width: 180rpx; height: 136rpx; margin-right: 12rpx; overflow: hidden; border-radius: 14rpx; }
.rental-image { width: 100%; height: 100%; }
.image-review-label { position: absolute; left: 0; right: 0; bottom: 0; padding: 7rpx 4rpx; color: #fff; background: rgba(200,150,62,.88); font-size: 19rpx; text-align: center; }
.image-review-rejected { background: rgba(155,61,26,.9); }
.owner-row { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(61,43,31,.08); color: #9c8f84; font-size: 22rpx; }
.publisher { display: flex; align-items: center; min-width: 0; }
.publisher-avatar { flex: none; width: 48rpx; height: 48rpx; border-radius: 50%; background: #eee5dc; }
.publisher-name { overflow: hidden; margin-left: 12rpx; text-overflow: ellipsis; white-space: nowrap; }
.owner-meta { display: flex; align-items: center; gap: 16rpx; }
.review-label { color: var(--gold); }.contact-text { color: #6b8e5a; }
.card-actions { justify-content: flex-end; gap: 34rpx; margin-top: 20rpx; color: var(--terracotta); font-size: 25rpx; }
.empty { display: flex; align-items: center; flex-direction: column; padding: 120rpx 30rpx; }.empty-title { color: var(--bark); font-size: 28rpx; }.empty-copy, .loading { margin-top: 14rpx; color: #9c8f84; font-size: 23rpx; text-align: center; }

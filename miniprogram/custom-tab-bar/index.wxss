.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  height: calc(50px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #fffaf5;
  border-top: 1rpx solid rgba(61, 43, 31, 0.06);
  box-shadow: 0 -4rpx 16rpx rgba(61, 43, 31, 0.03);
}

.tab-content {
  display: flex;
  height: 50px;
}

.tab-item {
  flex: 1;
  height: 50px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8a8a8a;
  font-size: 12px;
}

.tab-item.selected {
  color: #c4673c;
}

.tab-icon {
  width: 27px;
  height: 27px;
  margin-bottom: 1px;
}

.tab-text {
  line-height: 14px;
}

.tab-bar {
  display: flex;
  height: 104rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fffaf5;
  border-top: 1rpx solid rgba(61, 43, 31, 0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8a8a8a;
  font-size: 22rpx;
}

.tab-item.selected {
  color: #c4673c;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 2rpx;
}

.tab-text {
  line-height: 28rpx;
}
